# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/zyra

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRES_IN=7d
# Cookie name for the JWT
JWT_COOKIE_NAME=zyra_token

# CORS - comma separated allowed origins
CLIENT_URL=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_PRODUCT_FOLDER=ZYRA

# Clerk
CLERK_SECRET_KEY=your_clerk_secret_key

# AI Virtual Stylist (OpenAI-compatible chat API)
# Get a key from https://openrouter.ai/keys (free tier available) and paste it below.
# The feature still works without a key — it falls back to deterministic local recommendations.
# Do NOT prefix this with REACT_APP_ or VITE_; the value must never reach the frontend bundle.
STYLIST_API_KEY=
STYLIST_BASE_URL=https://openrouter.ai/api/v1
STYLIST_MODEL=openai/gpt-oss-20b:free

# =============================================================================
# SAFEPAY PAYMENT GATEWAY
# =============================================================================
# Environment: "sandbox" for testing, "production" for live payments
SAFEPAY_ENVIRONMENT=sandbox

# Safepay API Key (from your Safepay Dashboard)
# Sandbox: https://sandbox.api.getsafepay.com/dashboard
# Production: https://getsafepay.com/dashboard
SAFEPAY_API_KEY=

# Safepay Secret Key (server-side only - NEVER expose to frontend)
SAFEPAY_SECRET_KEY=

# Safepay Webhook Secret for HMAC verification (from Dashboard > Developers > Webhooks)
SAFEPAY_WEBHOOK_SECRET=

# Safepay Intent: "CYBERSOURCE" for Visa/Mastercard (recommended)
SAFEPAY_INTENT=CYBERSOURCE

# Your frontend URL (for redirect after payment)
SAFEPAY_CLIENT_URL=http://localhost:5173

# Webhook URL - configure this in your Safepay Dashboard
# Format: https://yourdomain.com/api/safepay/webhook
SAFEPAY_WEBHOOK_URL=https://yourdomain.com/api/safepay/webhook

